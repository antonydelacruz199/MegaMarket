DATABASE_URL=
JWT_SECRET=
PORT=8000
# Job servidor: resuelve sustituciones vencidas (1=on, 0=off). Intervalo en ms (mín. 1000).
SUSTITUCIONES_JOB=1
SUSTITUCIONES_JOB_MS=15000
# Medios. memory = proceso (pruebas). disk = carpeta local persistente.
# MEDIA_ROOT es absoluta o relativa a api-rest/. No versionar su contenido.
MEDIA_STORAGE=disk
MEDIA_ROOT=data/media
MEDIA_MAX_BYTES=5242880
MEDIA_URL_TTL_PRODUCTO=3600
MEDIA_URL_TTL_ENTREGA=600
